  "source_bodies": {
    "Sub_4682E0": "void __cdecl Sub_4682E0(\n    std::uint32_t a1,\n    std::int32_t a2,\n    std::uint32_t a3,\n    std::uint32_t a4,\n    std::uint32_t a5,\n    std::uint32_t a6,\n    std::uint32_t a7,\n    std::int32_t a8)\n{\n    gValueC35008 = a5;\n    gValue9DAD2C = a6;\n    gValue9FB930 = a3;\n    gValueC821D4 = a4;\n    gValue9A86DC = a1;\n    gMapFloor = a2;\n    Sub_46DA80(a1, a2, a8, a7);\n}\n\n",
    "Sub_46DA80": "void __cdecl Sub_46DA80(\n    std::uint32_t a1,\n    std::int32_t a2,\n    std::int32_t a3,\n    std::uint32_t a4)\n{\n    audio::Sub_52CD40();\n    gValue9DAD5C = a1;\n    gValue9DAD68 = a4;\n    gValue9DAD58 = a2;\n    if (a4 != 1) {\n        return;\n    }\n\n    const std::int32_t selected = a3 == -1 ? a2 : a3;\n    gValue9DAD60 = selected;\n    gValue9DAD64 = selected;\n    Sub_46DB00(selected);\n    Sub_46DC90(selected);\n    login::detail::Sub_46DD40();\n}\n\n",
    "Sub_46DD40": "void Sub_46DD40()\n{\n    for (std::size_t row = 0; row < kYobiRegistryRowCount; ++row) {\n        const std::size_t rowOffset = row * kYobiRegistryColumnCount;\n        for (std::size_t column = 0;\n             column < kYobiRegistryColumnCount;\n             ++column) {\n            const std::size_t index = rowOffset + column;\n            if (gYobiRegistryFlags[index] == std::uint8_t{1}) {\n                gYobiRegistryFlags[index] = std::uint8_t{0};\n                YobiAction* const action = gYobiRegistryActions[index];\n                MarkDeath(action);\n            }\n        }\n    }\n}\n\n"
  },
