  "source_bodies_before": [
    {
      "path": "src/render/SdlPresenter.cpp",
      "symbol": "RendererDestroy_44C3C0",
      "body": "void RendererDestroy_44C3C0() noexcept\n{\n    if (!SDL_IsMainThread()) {\n        return;\n    }\n    // 16 位专用 PALDATA 不属于当前 32 位 CPU 后端。\n    ReleaseTextureNodeSurfaces_44C408();\n    DestroyCpuCacheSurfaces();\n    ReleaseRendererTextureDevice();\n    ReleaseRendererTextureInterface();\n    ReleaseRendererPaletteBinding();\n    DestroyCpuBackSurface();\n    if (!DestroyRendererPresenter()) {\n        return; // 后端销毁失败时保留 owner，供主线程重试销毁。\n    }\n    ReleaseRendererResources();\n}"
    },
    {
      "path": "src/render/GraphicDxCache.cpp",
      "symbol": "ReleaseTextureNodeSurfaces_44C408",
      "body": "void ReleaseTextureNodeSurfaces_44C408() noexcept\n{\n    if (gTextureNodeCount <= 0) {\n        return;\n    }\n    std::int32_t index = 0;\n    do {\n        TextureNode& node = gTextureNodes[static_cast<std::size_t>(index)];\n        if (node.surface != nullptr) {\n            gTextureSurfaceOwner.Release(node.surface);\n            node.surface = nullptr;\n        }\n        ++index;\n    } while (index < gTextureNodeCount);\n}"
    }
  ],
  "source_patches": [
    {
      "scope": "helper_body",
      "path": "src/render/GraphicDxCache.cpp",
      "symbol": "ReleaseTextureNodeSurfaces_44C408",
      "before": "void ReleaseTextureNodeSurfaces_44C408() noexcept\n{\n    if (gTextureNodeCount <= 0) {\n        return;\n    }\n    std::int32_t index = 0;\n    do {\n        TextureNode& node = gTextureNodes[static_cast<std::size_t>(index)];\n        if (node.surface != nullptr) {\n            gTextureSurfaceOwner.Release(node.surface);\n            node.surface = nullptr;\n        }\n        ++index;\n    } while (index < gTextureNodeCount);\n}",
      "after": "void ReleaseTextureNodeSurfaces_44C408() noexcept\n{\n    const std::int32_t initialCount = gTextureNodeCount;\n    if (initialCount <= 0) {\n        return;\n    }\n\n    std::int32_t index = 0;\n    TextureNode* node = gTextureNodes.data();\n    for (;;) {\n        TextureSurface* const surface = node->surface;\n        if (surface != nullptr) {\n            gTextureSurfaceOwner.Release(surface);\n            node->surface = nullptr;\n        }\n        const std::int32_t currentCount = gTextureNodeCount;\n        ++index;\n        ++node;\n        if (index >= currentCount) {\n            break;\n        }\n    }\n}",
      "purpose": "原节点释放段单次保存实际surface与按原Count先取样、再推计数/实际节点native地址；仅非空时释放/清槽，其余节点与owner保。"
    }
  ],
