    "Sub_508C90": "std::int32_t Sub_508C90()\n{\n    if (gRequestStatus == 2) {\n        const std::uint16_t replyCode = gReplyCodeDA3B2E;\n        gRequestStatus = 0;\n        if (replyCode == 1) {\n            return 1;\n        }\n        return replyCode == 2 ? 2 : -2;\n    }\n\n    const std::uint32_t elapsed =\n        platform::ReadTickCount32() - gRequestStartTick;\n    if (elapsed <= kRequestTimeoutMilliseconds) {\n        return 0;\n    }\n\n    static_cast<void>(platform::FormatLegacyString_53B304(\n        gRequestMessage, kLogoutTimeoutMessage));\n    return -1;\n}\n\n",
    "StartCharacterDeletionRequest": "std::uint32_t StartCharacterDeletionRequest()\n{\n    const std::int16_t selected = gSelectedCharacterIndex;\n    gCharacterDeletionReplyCode = 0;\n\n    const std::uintptr_t socket = platform::gConnectionSocket;\n    const CharacterRecordBytes* const record = gCharacterRecords.data() + selected;\n    std::int32_t registNumber;\n    std::memcpy(\n        &registNumber,\n        record->data() + kRegistNumberOffset,\n        sizeof(registNumber));\n\n    network::Sub_512AB0(socket, registNumber);\n    gRequestStatus = 1;\n    const std::uint32_t tick = platform::ReadTickCount32();\n    gRequestStartTick = tick;\n    return tick;\n}\n\n",
